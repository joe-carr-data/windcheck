               gg.n_comp, gg.energy, gg.n_frustrated, gg.moves_applied,
               ves_clock_sec() - t0);
 
+    /* ---- optional diagnostic dump of the solved constraint graph.
+     * SF_GG_DUMP=<path> writes every node and every admitted edge of the
+     * transparent GroupGraph struct (the same array GroupGraph_build
+     * produced; solve only annotates it) as TSV. Pure read-only tap at the
+     * tool level: nothing in build/solve/finalize is touched, and with the
+     * env var unset this block is a single getenv. ---- */
+    {
+        const char *ggp = getenv("SF_GG_DUMP");
+        if (ggp != NULL && ggp[0] != '\0') {
+            FILE *gf = fopen(ggp, "w");
+            if (gf == NULL) {
+                logf_both("[reregister] gg dump: cannot open %s\n", ggp);
+            } else {
+                size_t di;
+                fprintf(gf, "# gg_dump v1\n");
+                fprintf(gf, "# node\tid\tcube_idx\tcube_id\tgid\tk\tdu\t"
+                            "prior\tn_prior\tcomp\n");
+                for (di = 0; di < gg.n_nodes; di++) {
+                    const GGNode *nd = &gg.nodes[di];
+                    fprintf(gf, "node\t%zu\t%d\t%s\t%d\t%d\t%.17g\t%.17g\t"
+                                "%d\t%d\n",
+                            di, nd->cube, nodes[nd->cube].id, nd->gid,
+                            nd->k, nd->du, nd->prior, nd->n_prior, nd->comp);
+                }
+                fprintf(gf, "# edge\ta\tb\tcube_a\tgid_a\tcube_b\tgid_b\t"
+                            "obs\tdu\tconf\tmad\tn\tin_tree\n");
+                for (di = 0; di < gg.n_edges; di++) {
+                    const GGEdge *ed = &gg.edges[di];
+                    const GGNode *na = &gg.nodes[ed->a];
+                    const GGNode *nb = &gg.nodes[ed->b];
+                    fprintf(gf, "edge\t%d\t%d\t%s\t%d\t%s\t%d\t%d\t%.17g\t"
+                                "%.17g\t%.17g\t%d\t%d\n",
+                            ed->a, ed->b, nodes[na->cube].id, na->gid,
+                            nodes[nb->cube].id, nb->gid, ed->obs, ed->du,
+                            ed->conf, ed->mad, ed->n, (int)ed->in_tree);
+                }
+                fclose(gf);
+                logf_both("[reregister] gg dump: %zu nodes, %zu edges -> "
+                          "%s\n", gg.n_nodes, gg.n_edges, ggp);
+            }
+        }
+    }
+
