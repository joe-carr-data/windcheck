# Data is never committed: it is public, large, and re-fetchable from S3.
# Provenance lives in data/MANIFEST.json (hashes + exact s3 keys), which IS committed.
data/**
!data/MANIFEST.json
!data/.gitkeep

# Derived outputs — regenerated by the pipeline, pinned by hash in runs/
/out/*
# ...except the release index, which is a published artifact.
!/out/release/
*.bin
*.npy
*.npz

# Python / uv
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# macOS
.DS_Store

# compiled engines (built locally; see README)
engines/atlas_query
engines/selfcross
engines/geodesic
